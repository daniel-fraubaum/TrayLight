<UserControl x:Class="TrayLight.Views.InfoItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TrayLight.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:InfoItemViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Button Style="{StaticResource TileButtonStyle}"
            Command="{Binding ActivateCommand}"
            IsEnabled="{Binding IsClickable}"
            ToolTip="{Binding ValueTooltip}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Icon in accent-colored circle. Slightly smaller (32px) so
                 the value text gets more breathing room on narrow tiles. -->
            <Grid Grid.Column="0" Width="32" Height="32" Margin="0,0,10,0">
                <Ellipse x:Name="IconBackground" />
                <TextBlock Text="{Binding IconGlyph}"
                           Style="{StaticResource IconGlyphStyle}"
                           FontSize="14" />
                <!-- Warning badge overlay. -->
                <Border Width="14" Height="14"
                        CornerRadius="7"
                        Background="{DynamicResource WarningBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-2,-2,0"
                        Visibility="{Binding HasWarning, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <TextBlock Text="!"
                               Foreground="White"
                               FontFamily="{StaticResource UiFontFamily}"
                               FontSize="10"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Style="{StaticResource LabelTextStyle}" />
                <TextBlock Text="{Binding Value}"
                           Style="{StaticResource BodyTextStyle}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap"
                           MaxHeight="34"
                           ToolTip="{Binding ValueTooltip}"
                           Margin="0,2,0,0" />
                <!-- Optional second line (e.g. the network tile's IPv4). A
                     left-aligned Viewbox with StretchDirection=DownOnly shrinks
                     the text only when it would overflow, so a full 15-char
                     IPv4 (255.255.255.255) always fits without truncation. The
                     full value stays available via the tooltip. -->
                <Viewbox HorizontalAlignment="Left"
                         StretchDirection="DownOnly"
                         Stretch="Uniform"
                         MaxHeight="16"
                         Margin="0,1,0,0"
                         Visibility="{Binding ValueSecondLine, Converter={x:Static vm:NonEmptyToVisibilityConverter.Instance}}">
                    <TextBlock Text="{Binding ValueSecondLine}"
                               Style="{StaticResource BodyTextStyle}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextWrapping="NoWrap"
                               ToolTip="{Binding ValueTooltip}" />
                </Viewbox>
            </StackPanel>
        </Grid>
    </Button>
</UserControl>
