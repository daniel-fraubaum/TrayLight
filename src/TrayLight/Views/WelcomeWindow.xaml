<Window x:Class="TrayLight.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TrayLight.ViewModels"
        xmlns:res="clr-namespace:TrayLight.Resources"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:WelcomeViewModel}"
        Title="{x:Static res:Strings.WelcomeTitle}"
        Width="640" Height="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        Background="Transparent"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary x:Name="ThemeDictionary" Source="/Themes/Light.xaml" />
                <ResourceDictionary Source="/Themes/Common.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FeatureCardStyle" TargetType="Border">
                <Setter Property="Background"      Value="{DynamicResource SurfaceBrush}" />
                <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrushSubtle}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius"    Value="10" />
                <Setter Property="Padding"         Value="16" />
                <Setter Property="Margin"          Value="6" />
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background"      Value="{Binding AccentBrush}" />
                <Setter Property="Foreground"      Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding"         Value="20,9" />
                <Setter Property="FontFamily"      Value="{StaticResource UiFontFamily}" />
                <Setter Property="FontSize"        Value="13" />
                <Setter Property="FontWeight"      Value="SemiBold" />
                <Setter Property="Cursor"          Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.78" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="8"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrushSubtle}"
            BorderThickness="1"
            Padding="28,24"
            TextElement.FontFamily="{StaticResource UiFontFamily}"
            TextElement.Foreground="{DynamicResource TextPrimaryBrush}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- 0 close button row -->
                <RowDefinition Height="Auto" /> <!-- 1 header           -->
                <RowDefinition Height="Auto" /> <!-- 2 subtitle         -->
                <RowDefinition Height="*"    /> <!-- 3 feature cards    -->
                <RowDefinition Height="Auto" /> <!-- 4 actions row      -->
                <RowDefinition Height="Auto" /> <!-- 5 powered by       -->
            </Grid.RowDefinitions>

            <!-- Title bar drag handle (no chrome) + close button. -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Button Width="28" Height="28"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CloseButton_Click"
                        ToolTip="{x:Static res:Strings.Close}">
                    <TextBlock Text="&#xE8BB;"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Button>
            </Grid>

            <!-- ===================== HEADER ===================== -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       MaxHeight="40" Stretch="Uniform"
                       VerticalAlignment="Center"
                       Margin="0,0,14,0"
                       Source="{Binding LogoSource}"
                       Visibility="{Binding LogoSource, Converter={x:Static vm:NonEmptyToVisibilityConverter.Instance}}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               Style="{StaticResource HeaderTitleStyle}"
                               FontSize="24" />
                    <TextBlock Text="{Binding CompanyName}"
                               Style="{StaticResource LabelTextStyle}"
                               Visibility="{Binding CompanyName, Converter={x:Static vm:NonEmptyToVisibilityConverter.Instance}}" />
                </StackPanel>
            </Grid>

            <!-- ===================== SUBTITLE ===================== -->
            <TextBlock Grid.Row="2"
                       Text="{Binding Subtitle}"
                       Style="{StaticResource BodyTextStyle}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,18" />

            <!-- ===================== FEATURE CARDS ===================== -->
            <ItemsControl Grid.Row="3" ItemsSource="{Binding Features}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FeatureCardViewModel}">
                        <Border Style="{StaticResource FeatureCardStyle}">
                            <StackPanel>
                                <Border Width="40" Height="40"
                                        CornerRadius="20"
                                        HorizontalAlignment="Left"
                                        Background="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <TextBlock Text="{Binding IconGlyph}"
                                               FontFamily="{StaticResource IconFontFamily}"
                                               FontSize="20"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Title}"
                                           FontFamily="{StaticResource UiFontFamily}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,12,0,4" />
                                <TextBlock Text="{Binding Body}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===================== ACTIONS ===================== -->
            <Grid Grid.Row="4" Margin="0,18,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          IsChecked="{Binding DoNotShowAgain, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          FontFamily="{StaticResource UiFontFamily}"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          Content="{x:Static res:Strings.DoNotShowAgain}" />

                <Button Grid.Column="1"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="{x:Static res:Strings.GetStarted}"
                        Command="{Binding GetStartedCommand}" />
            </Grid>

            <!-- =============== FIXED, NON-CONFIGURABLE FOOTER =============== -->
            <TextBlock Grid.Row="5"
                       Style="{StaticResource PoweredByStyle}"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0">
                <Run Text="{Binding PoweredBy, Mode=OneWay}" />
                <Hyperlink NavigateUri="{Binding PoweredByLinkUrl}"
                           RequestNavigate="PoweredBy_RequestNavigate"
                           TextDecorations="None"
                           Foreground="{Binding AccentBrush}">
                    <Run Text="{Binding PoweredByLink, Mode=OneWay}" />
                </Hyperlink>
            </TextBlock>
        </Grid>
    </Border>
</Window>
