<UserControl x:Class="TrayLight.Views.ShortcutButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TrayLight.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ShortcutViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Button Style="{StaticResource TileButtonStyle}"
            Command="{Binding ActivateCommand}"
            ToolTip="{Binding Subtitle}"
            Padding="6,10">
        <StackPanel HorizontalAlignment="Center">
            <Grid Width="32" Height="32" HorizontalAlignment="Center">
                <Ellipse x:Name="IconBackground" />
                <TextBlock Text="{Binding IconGlyph}"
                           Style="{StaticResource IconGlyphStyle}"
                           FontSize="16" />
            </Grid>
            <!-- Single line by default; wraps to a second line only for long
                 localized labels (that shortcut row then grows), ellipsized beyond. -->
            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource BodyTextStyle}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,6,0,0" />
        </StackPanel>
    </Button>
</UserControl>
