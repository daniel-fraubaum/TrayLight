<Application x:Class="TrayLight.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Common.xaml is merged at the application level so styles
                     like TileButtonStyle / BodyTextStyle / IconGlyphStyle are
                     visible to UserControls (InfoItemControl, ShortcutButton)
                     during XAML parse — those controls are loaded standalone
                     and StaticResource lookup cannot reach a parent Window's
                     resources at parse time. -->
                <ResourceDictionary Source="/Themes/Common.xaml" />
                <ResourceDictionary Source="/Views/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
