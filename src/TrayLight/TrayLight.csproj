<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TrayLight</RootNamespace>
    <AssemblyName>TrayLight</AssemblyName>
    <Product>TrayLight</Product>
    <Authors>headsinthecloud.blog</Authors>
    <Company>headsinthecloud.blog</Company>
    <Copyright>© headsinthecloud.blog - Daniel Fraubaum</Copyright>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Self-contained: the published app ships its own .NET runtime, so no
         framework needs to be installed on the target machine. Trimming is
         not supported by WPF, so we use ReadyToRun for startup performance
         instead. -->
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!-- Only set ApplicationIcon when the file is actually present, so the
       project still builds in environments where the icon is missing. -->
  <PropertyGroup Condition="Exists('Assets\app-normal.ico')">
    <ApplicationIcon>Assets\app-normal.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.2.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app-normal.ico"     Condition="Exists('Assets\app-normal.ico')" />
    <Resource Include="Assets\app-warning.ico"    Condition="Exists('Assets\app-warning.ico')" />
    <Resource Include="Assets\default-logo.png"   Condition="Exists('Assets\default-logo.png')" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TrayLight.Tests" />
  </ItemGroup>

</Project>
